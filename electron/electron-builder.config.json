{
  "appId": "com.fan.pomoclock",
  "productName": "番茄时钟",
  "executableName": "番茄时钟",
  "directories": {
    "buildResources": "resources",
    "output": "release"
  },
  "asar": false,
  "files": [
    "assets/**/*",
    "build/**/*",
    "capacitor.config.*",
    "app/**/*",
    "package.json"
  ],
  "publish": null,
  "mac": {
    "category": "public.app-category.productivity",
    "target": [
      {
        "target": "dmg",
        "arch": ["x64", "arm64"]
      }
    ],
    "icon": "assets/appIcon.png"
  },
  "dmg": {
    "title": "番茄时钟",
    "contents": [
      {
        "x": 130,
        "y": 220
      },
      {
        "x": 410,
        "y": 220,
        "type": "link",
        "path": "/Applications"
      }
    ]
  }
}
